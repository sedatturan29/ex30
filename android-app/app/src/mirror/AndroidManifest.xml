<?xml version="1.0" encoding="utf-8"?>
<!-- Ekran yansıtma başlatıcıları (Android Auto'da telefon uygulamalarını gösteren uygulamalar) için deneme sürümü:
     Android Auto bildirimleri çıkarıldı; bazı başlatıcılar zaten Android Auto uygulaması olanları listelemiyor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="EX30 Reader Ayna" tools:replace="android:label">
        <service android:name=".EX30CarAppService" tools:node="remove" />
        <meta-data android:name="com.google.android.gms.car.application" tools:node="remove" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" tools:node="remove" />
        <service android:name=".AutoStartService" tools:node="remove" />
    </application>
</manifest>
